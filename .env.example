DATABASE_URL="postgresql://actbyme:actbyme@localhost:5432/actbyme?schema=public"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
API_PORT="4000"
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_DIRECTOR_MODEL="gemini-3.8-flash"
GEMINI_DIRECTOR_FALLBACK_MODELS="gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite"
GEMINI_TRANSCRIPTION_MODEL="gemini-3.5-transcribe"
GEMINI_VISUAL_QA_MODEL="gemini-3.8-flash"
GEMINI_VISUAL_QA_FALLBACK_MODELS="gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI Virtual Director: API + dedicated video worker (never NEXT_PUBLIC_).
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
FAL_KEY=""
# Required: verify the current Seedance 2 reference-to-video 720p price, in USD cents/second.
# 0 deliberately disables paid generation until a price is configured.
VIRTUAL_DIRECTOR_CENTS_PER_SECOND="0"
VIRTUAL_DIRECTOR_MONTHLY_BUDGET_CENTS="2500"
BLENDER_PATH="blender"
# For local execution from repo root; Docker sets its working directory to apps/api.
BLENDER_PREVIEW_SCRIPT=""

# ACTBYME Director: free browser export + inspection in the existing API.
# Optional paid provider configuration (disabled by default).
# Browser 3D preview and production JSON export never use these provider keys.
DIRECTOR_VEO_API_KEY=""
DIRECTOR_HIGGSFIELD_API_KEY=""
# Verified conservative USD cents per output second. 0 disables paid submission.
DIRECTOR_VEO_CENTS_PER_SECOND="0"
DIRECTOR_HIGGSFIELD_CENTS_PER_SECOND="0"
DIRECTOR_MONTHLY_BUDGET_CENTS="2500"
# Explicit HTTPS result hosts from your Higgsfield account, comma separated.
DIRECTOR_HIGGSFIELD_MEDIA_HOSTS="cdn.higgsfield.ai,storage.googleapis.com"

# Director fonctionne gratuitement avec clips importés et export navigateur.
# Activation volontaire uniquement après validation des tarifs et du fournisseur.
DIRECTOR_ENABLE_PAID_GENERATION=false
