generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACTOR
  CLIENT
  AGENCY
}

enum ActorProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum SkillCategory {
  ACTING
  VOICE
  SINGING
  DANCE
  MARTIAL_ARTS
  STUNTS
  SPORTS
  COMEDY
  DRAMA
  UGC_ADS
  CORPORATE
  BODY_MOVEMENT
  EMOTIONAL_PERFORMANCE
}

enum VideoType {
  INTRO
  ACTING_TEST
  MOTION_TEST
  VOICE_SAMPLE
  PORTFOLIO
  BEFORE_AFTER_AI
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum AgencyRequestStatus {
  NEW
  CONTACTED
  APPROVED
  REJECTED
}

enum PerformancePath {
  SELF
  TEAM_MEMBER
  ACTBYME_PERFORMER
}

enum PerformanceWorkflowStatus {
  DRAFT
  READY_FOR_BRIEF
  GENERATING_BRIEF
  BRIEF_REVIEW
  BRIEF_APPROVED
  PERFORMER_SELECTION
  COMPANY_DETAILS
  PROJECT_DETAILS
  SETUP_REVIEW
  BRIEF_PROCESSING
  BRIEF_READY
  PERFORMANCE_SOURCE
  ACTOR_SELECTION
  REQUEST_SUMMARY
  PERFORMANCE_PROGRESS
  QA_PENDING
  CLIENT_REVIEW
  APPROVED_DELIVERY
}

enum PerformanceTakeUploadStatus {
  UPLOADING
  UPLOADED
  FAILED
}

enum PerformanceTakeStatus {
  DRAFT
  SUBMITTED
  QA_RUNNING
  QA_FAILED
  QA_PASSED
  APPROVED
}

enum PerformanceQaRunStatus {
  RUNNING
  COMPLETED
  ERROR
}

enum PerformanceQaResultStatus {
  PASS
  FAIL
}

enum PerformanceQaCheckType {
  FILE_CODEC
  DURATION
  RESOLUTION_ORIENTATION
  AUDIO_PRESENCE
  DIALOGUE_ACCURACY
  VISUAL_COMPLIANCE
}

enum PerformanceBriefAttachmentStatus {
  UPLOADING
  PARSING
  READY
  FAILED
}

enum PerformanceAssignmentStatus {
  SELECTED
  ACCEPTED
  SUBMITTED
  QA_RUNNING
  QA_PASSED
  QA_FAILED
}

enum NotificationType {
  PERFORMANCE_REQUEST
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  email               String                  @unique
  name                String?
  role                UserRole                @default(ACTOR)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  actorProfile        ActorProfile?
  auditLogs           AuditLog[]
  notifications       Notification[]
  performanceProjects PerformanceProject[]
  studioComments      DirectorStudioComment[]
  directorProjects    DirectorProject[]

  @@index([role])
  @@index([createdAt])
}

model ActorProfile {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @unique @db.Uuid
  slug                   String                  @unique
  stageName              String
  bio                    String?                 @db.Text
  country                String?
  city                   String?
  profileImageUrl        String?                 @db.Text
  heroVideoUrl           String?                 @db.Text
  actAiScore             Int?
  isDemo                 Boolean                 @default(false)
  status                 ActorProfileStatus      @default(DRAFT)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                 ActorSkill[]
  languages              ActorLanguage[]
  accents                ActorAccent[]
  videos                 ActorVideo[]
  consent                ActorConsent?
  demoProfile            DemoProfile?
  auditLogs              AuditLog[]
  performanceAssignments PerformanceAssignment[]
  directorGrants         DirectorActorGrant[]

  @@index([slug])
  @@index([status])
  @@index([isDemo])
  @@index([createdAt])
}

model ActorSkill {
  id              String        @id @default(uuid()) @db.Uuid
  actorProfileId  String        @db.Uuid
  category        SkillCategory
  label           String?
  yearsExperience Int?
  createdAt       DateTime      @default(now())
  actorProfile    ActorProfile  @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@unique([actorProfileId, category, label])
  @@index([category])
  @@index([actorProfileId])
}

model ActorLanguage {
  id             String       @id @default(uuid()) @db.Uuid
  actorProfileId String       @db.Uuid
  language       String
  proficiency    String?
  createdAt      DateTime     @default(now())
  actorProfile   ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@unique([actorProfileId, language])
  @@index([language])
  @@index([actorProfileId])
}

model ActorAccent {
  id             String       @id @default(uuid()) @db.Uuid
  actorProfileId String       @db.Uuid
  accent         String
  createdAt      DateTime     @default(now())
  actorProfile   ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@unique([actorProfileId, accent])
  @@index([accent])
  @@index([actorProfileId])
}

model ActorVideo {
  id              String         @id @default(uuid()) @db.Uuid
  actorProfileId  String         @db.Uuid
  title           String
  description     String?        @db.Text
  videoUrl        String         @db.Text
  thumbnailUrl    String?        @db.Text
  type            VideoType
  visibility      Visibility     @default(PUBLIC)
  durationSeconds Int?
  skillCategory   SkillCategory?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  actorProfile    ActorProfile   @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([visibility])
  @@index([skillCategory])
  @@index([actorProfileId, sortOrder])
}

model ActorConsent {
  id                                     String       @id @default(uuid()) @db.Uuid
  actorProfileId                         String       @unique @db.Uuid
  publicProfileConsent                   Boolean      @default(false)
  marketingUsageConsent                  Boolean      @default(false)
  ownsUploadedContentConfirmation        Boolean      @default(false)
  futurePaidWorkRequiresSeparateApproval Boolean      @default(false)
  acceptedAt                             DateTime?
  createdAt                              DateTime     @default(now())
  updatedAt                              DateTime     @updatedAt
  actorProfile                           ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)
}

model AgencyAccessRequest {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String
  companyName           String
  role                  String?
  email                 String
  website               String?             @db.Text
  country               String?
  needs                 String              @db.Text
  expectedMonthlyVolume String?
  interestedSkills      String[]
  status                AgencyRequestStatus @default(NEW)
  message               String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

model EarlyAccessSignup {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PerformanceProject {
  id                  String                      @id @default(uuid()) @db.Uuid
  ownerId             String                      @db.Uuid
  title               String
  type                String
  objective           String?                     @db.Text
  location            String?
  locationData        Json?
  targetAiTool        String?
  language            String?
  notes               String?                     @db.Text
  script              String?                     @db.Text
  sourceFileName      String?
  companyName         String
  companyWebsite      String?                     @db.Text
  organizationType    String?
  contactName         String?
  contactRole         String?
  performerPath       PerformancePath?
  workflowStatus      PerformanceWorkflowStatus   @default(DRAFT)
  currentStep         String                      @default("company")
  deliveryCompletedAt DateTime?
  actorGuide          Json?
  aiEnginePrompt      String?                     @db.Text
  outputsBriefVersion Int?
  outputsGeneratedAt  DateTime?
  outputsModel        String?
  outputsProvider     String?
  outputsResponseId   String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  owner               User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  brief               PerformanceBrief?
  briefAttachment     PerformanceBriefAttachment?
  scenes              PerformanceScene[]
  takes               PerformanceTake[]
  qaRuns              PerformanceQaRun[]
  consents            PerformanceConsent[]
  assignment          PerformanceAssignment?
  directorStudio      DirectorStudio?
  virtualDirector     VirtualDirector?
  virtualReferences   VirtualDirectorReference[]
  virtualJobs         VirtualDirectorJob[]

  @@index([ownerId, updatedAt])
  @@index([workflowStatus])
}

model PerformanceConsent {
  id                      String             @id @default(uuid()) @db.Uuid
  projectId               String             @db.Uuid
  version                 Int                @default(1)
  approvedBriefVersion    Int
  performerName           String?
  performerEmail          String?
  usagePurpose            String?            @db.Text
  commercialUse           Boolean?
  aiTransformationAllowed Boolean?
  modelTrainingAllowed    Boolean?
  territory               String?
  usageDuration           String?
  restrictions            String?            @db.Text
  acceptedAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  project                 PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, acceptedAt])
}

model PerformanceBriefAttachment {
  id               String                           @id @default(uuid()) @db.Uuid
  projectId        String                           @unique @db.Uuid
  uploadAttemptId  String                           @db.Uuid
  originalFileName String
  contentType      String
  sizeBytes        Int
  storageBucket    String
  storagePath      String                           @db.Text
  status           PerformanceBriefAttachmentStatus @default(UPLOADING)
  extractedText    String?                          @db.Text
  extractionError  String?                          @db.Text
  uploadedAt       DateTime?
  parsedAt         DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  project          PerformanceProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PerformanceBrief {
  id                 String             @id @default(uuid()) @db.Uuid
  projectId          String             @unique @db.Uuid
  talentRequirements Json
  capturePlan        Json
  globalDirection    String             @db.Text
  qaCriteria         Json
  model              String
  openaiResponseId   String?
  version            Int                @default(1)
  approvedVersion    Int?
  approvedAt         DateTime?
  generatedAt        DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  project            PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PerformanceScene {
  id                   String             @id @default(uuid()) @db.Uuid
  projectId            String             @db.Uuid
  position             Int
  title                String
  duration             String?
  referenceUrl         String?            @db.Text
  dialogue             String?            @db.Text
  direction            String?            @db.Text
  emotionalProgression String?            @db.Text
  startingPosition     String?            @db.Text
  bodyPosition         String?            @db.Text
  eyeline              String?            @db.Text
  gestures             String?            @db.Text
  framing              String?            @db.Text
  captureRequirements  String?            @db.Text
  uploadedFileName     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  project              PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  take                 PerformanceTake?
  qaRuns               PerformanceQaRun[]

  @@unique([projectId, position])
  @@index([projectId])
}

model PerformanceAssignment {
  id               String                      @id @default(uuid()) @db.Uuid
  projectId        String                      @unique @db.Uuid
  actorProfileId   String                      @db.Uuid
  status           PerformanceAssignmentStatus @default(SELECTED)
  sentAt           DateTime?
  acceptedAt       DateTime?
  submittedAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  project          PerformanceProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorProfile     ActorProfile                @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  notifications    Notification[]
  studioRevisionId String?                     @db.Uuid
  studioRevision   DirectorStudioRevision?     @relation(fields: [studioRevisionId], references: [id], onDelete: Restrict)

  @@index([actorProfileId, status])
  @@index([status])
}

model Notification {
  id                      String                 @id @default(uuid()) @db.Uuid
  userId                  String                 @db.Uuid
  type                    NotificationType
  title                   String
  body                    String                 @db.Text
  link                    String
  metadata                Json?
  readAt                  DateTime?
  emailSentAt             DateTime?
  emailError              String?                @db.Text
  performanceAssignmentId String?                @db.Uuid
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  performanceAssignment   PerformanceAssignment? @relation(fields: [performanceAssignmentId], references: [id], onDelete: Cascade)

  @@unique([performanceAssignmentId, type])
  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

model PerformanceTake {
  id               String                      @id @default(uuid()) @db.Uuid
  projectId        String                      @db.Uuid
  sceneId          String                      @unique @db.Uuid
  uploadAttemptId  String                      @db.Uuid
  originalFileName String
  contentType      String
  sizeBytes        Int
  storageBucket    String
  storagePath      String                      @db.Text
  uploadStatus     PerformanceTakeUploadStatus @default(UPLOADING)
  takeStatus       PerformanceTakeStatus       @default(DRAFT)
  uploadError      String?                     @db.Text
  uploadedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  project          PerformanceProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene            PerformanceScene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  qaRuns           PerformanceQaRun[]

  @@index([projectId])
  @@index([uploadStatus])
  @@index([takeStatus])
}

model PerformanceQaRun {
  id                   String                     @id @default(uuid()) @db.Uuid
  takeId               String                     @db.Uuid
  projectId            String                     @db.Uuid
  sceneId              String                     @db.Uuid
  uploadAttemptId      String                     @db.Uuid
  approvedBriefVersion Int
  status               PerformanceQaRunStatus     @default(RUNNING)
  result               PerformanceQaResultStatus?
  transcript           String?                    @db.Text
  transcriptionModel   String?
  processingError      String?                    @db.Text
  startedAt            DateTime                   @default(now())
  completedAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  take                 PerformanceTake            @relation(fields: [takeId], references: [id], onDelete: Cascade)
  project              PerformanceProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene                PerformanceScene           @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  checks               PerformanceQaCheckResult[]

  @@index([takeId, createdAt])
  @@index([projectId])
  @@index([sceneId])
  @@index([status])
}

model PerformanceQaCheckResult {
  id                    String                    @id @default(uuid()) @db.Uuid
  qaRunId               String                    @db.Uuid
  type                  PerformanceQaCheckType
  result                PerformanceQaResultStatus
  requiredValue         Json?
  measuredValue         Json
  correctionInstruction String?                   @db.Text
  createdAt             DateTime                  @default(now())
  qaRun                 PerformanceQaRun          @relation(fields: [qaRunId], references: [id], onDelete: Cascade)

  @@unique([qaRunId, type])
  @@index([result])
}

model DemoProfile {
  id             String       @id @default(uuid()) @db.Uuid
  actorProfileId String       @unique @db.Uuid
  label          String       @default("Demo profile")
  description    String?      @db.Text
  source         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  actorProfile   ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  userId         String?       @db.Uuid
  actorProfileId String?       @db.Uuid
  createdAt      DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorProfile   ActorProfile? @relation(fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorProfileId])
  @@index([action])
  @@index([createdAt])
}

model DirectorStudio {
  id                String                   @id @default(uuid()) @db.Uuid
  projectId         String                   @unique @db.Uuid
  enabled           Boolean                  @default(true)
  version           Int                      @default(0)
  draftInstructions String                   @default("") @db.Text
  project           PerformanceProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions         DirectorStudioRevision[]
  jobs              DirectorStudioJob[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model DirectorStudioRevision {
  id            String                  @id @default(uuid()) @db.Uuid
  studioId      String                  @db.Uuid
  version       Int
  scene         Json
  recordingPlan Json?
  instructions  String                  @db.Text
  label         String                  @default("Edited scene")
  roleId        String?
  inputHash     String
  approvedAt    DateTime?
  model         String?
  responseId    String?
  studio        DirectorStudio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  assignments   PerformanceAssignment[]
  shares        DirectorStudioShare[]
  comments      DirectorStudioComment[]
  createdAt     DateTime                @default(now())

  @@unique([studioId, version])
}

model DirectorStudioJob {
  id              String         @id @default(uuid()) @db.Uuid
  studioId        String         @db.Uuid
  expectedVersion Int
  input           Json
  status          String         @default("QUEUED")
  error           String?        @db.Text
  token           String?        @db.Uuid
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  studio          DirectorStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model DirectorStudioShare {
  id            String                  @id @default(uuid()) @db.Uuid
  tokenHash     String                  @unique
  revisionId    String                  @db.Uuid
  revision      DirectorStudioRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime                @default(now())
  allowComments Boolean                 @default(false)
  comments      DirectorStudioComment[]

  @@index([revisionId, createdAt])
}

model DirectorStudioComment {
  id         String                 @id @default(uuid()) @db.Uuid
  revisionId String                 @db.Uuid
  shareId    String                 @db.Uuid
  authorId   String                 @db.Uuid
  authorName String
  body       String                 @db.Text
  time       Float
  target     Json
  resolved   Boolean                @default(false)
  createdAt  DateTime               @default(now())
  revision   DirectorStudioRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  share      DirectorStudioShare    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  author     User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([revisionId, createdAt])
}

// Private server-only production assets. Never exposed through Supabase Data API.
model VirtualDirector {
  projectId String             @id @db.Uuid
  version   Int                @default(0)
  scene     Json
  project   PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt DateTime           @updatedAt
}

model VirtualDirectorReference {
  id              String               @id @default(uuid()) @db.Uuid
  projectId       String               @db.Uuid
  name            String
  storageKey      String               @db.Text
  sizeBytes       Int
  status          String               @default("UPLOADING")
  duration        Float?
  width           Int?
  height          Int?
  hasAudio        Boolean?
  rights          Json
  sourceTakeId    String?              @db.Uuid
  sourceAttemptId String?              @db.Uuid
  error           String?              @db.Text
  createdAt       DateTime             @default(dbgenerated("timezone('UTC', now())"))
  project         PerformanceProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs            VirtualDirectorJob[]

  @@index([projectId, createdAt])
}

model VirtualDirectorJob {
  id                 String                    @id @default(uuid()) @db.Uuid
  projectId          String                    @db.Uuid
  referenceId        String?                   @db.Uuid
  requestKey         String                    @db.Uuid
  kind               String
  shotId             String?
  status             String                    @default("QUEUED")
  stage              String                    @default("QUEUED")
  input              Json
  estimatedCostCents Int                       @default(0)
  cleanedAt          DateTime?
  providerRequest    Json?
  outputKey          String?                   @db.Text
  error              String?                   @db.Text
  token              String?                   @db.Uuid
  leaseUntil         DateTime?
  nextRunAt          DateTime                  @default(dbgenerated("timezone('UTC', now())"))
  deadlineAt         DateTime
  failures           Int                       @default(0)
  approvedAt         DateTime?
  createdAt          DateTime                  @default(dbgenerated("timezone('UTC', now())"))
  completedAt        DateTime?
  project            PerformanceProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reference          VirtualDirectorReference? @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@unique([projectId, requestKey])
  @@index([status, nextRunAt])
  @@index([projectId, createdAt])
}

model VirtualDirectorWorker {
  id      String   @id
  seenAt  DateTime @default(dbgenerated("timezone('UTC', now())"))
  blender Boolean  @default(false)
}

// Advertising editor. Independent from actor-facing shooting instructions.
model DirectorProject {
  id        String             @id @default(uuid()) @db.Uuid
  ownerId   String             @db.Uuid
  title     String
  version   Int                @default(1)
  document  Json
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revisions DirectorRevision[]
  assets    DirectorAsset[]
  jobs      DirectorJob[]
  grants    DirectorActorGrant[]

  @@index([ownerId, updatedAt])
}

model DirectorRevision {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  version   Int
  document  Json
  createdAt DateTime        @default(now())
  project   DirectorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model DirectorAsset {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @db.Uuid
  name              String
  kind              String
  contentType       String
  sizeBytes         Int
  storageKey        String          @db.Text
  status            String          @default("UPLOADING")
  duration          Float?
  width             Int?
  height            Int?
  hasAudio          Boolean?
  rights            Json
  aiTransferAllowed Boolean         @default(false)
  error             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  project           DirectorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model DirectorJob {
  id                 String          @id @default(uuid()) @db.Uuid
  projectId          String          @db.Uuid
  ownerId            String          @db.Uuid
  requestKey         String          @db.Uuid
  requestHash        String
  version            Int
  kind               String
  shotId             String?
  provider           String?
  status             String          @default("QUEUED")
  stage              String          @default("En attente du worker")
  progress           Int             @default(0)
  input              Json
  providerRequest    Json?
  resultAssetId      String?         @db.Uuid
  estimatedCostCents Int             @default(0)
  error              String?         @db.Text
  attempts           Int             @default(0)
  claimToken         String?         @db.Uuid
  leaseUntil         DateTime?
  nextRunAt          DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  project            DirectorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([ownerId, requestKey])
  @@index([status, nextRunAt, leaseUntil])
  @@index([projectId, createdAt])
  @@index([ownerId, createdAt])
}

model DirectorWorker {
  id        String   @id
  seenAt    DateTime @default(now())
  providers Json
}

model DirectorActorGrant {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  actorProfileId String          @db.Uuid
  scopeHash      String
  terms          String          @db.Text
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())
  project        DirectorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorProfile   ActorProfile    @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@unique([projectId, actorProfileId, scopeHash])
  @@index([actorProfileId, createdAt])
}
