generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACTOR
  CLIENT
  AGENCY
}

enum ActorProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum SkillCategory {
  ACTING
  VOICE
  SINGING
  DANCE
  MARTIAL_ARTS
  STUNTS
  SPORTS
  COMEDY
  DRAMA
  UGC_ADS
  CORPORATE
  BODY_MOVEMENT
  EMOTIONAL_PERFORMANCE
}

enum VideoType {
  INTRO
  ACTING_TEST
  MOTION_TEST
  VOICE_SAMPLE
  PORTFOLIO
  BEFORE_AFTER_AI
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum AgencyRequestStatus {
  NEW
  CONTACTED
  APPROVED
  REJECTED
}

enum PerformancePath {
  MATCHED_ACTOR
  INVITED_ACTOR
  SELF_UPLOAD
}

enum PerformanceWorkflowStatus {
  DRAFT
  READY_FOR_BRIEF
  GENERATING_BRIEF
  BRIEF_REVIEW
  COMPANY_DETAILS
  PROJECT_DETAILS
  SETUP_REVIEW
  BRIEF_PROCESSING
  BRIEF_READY
  PERFORMANCE_SOURCE
  ACTOR_SELECTION
  REQUEST_SUMMARY
  PERFORMANCE_PROGRESS
  QA_PENDING
  CLIENT_REVIEW
  APPROVED_DELIVERY
}

enum PerformanceTakeUploadStatus {
  UPLOADING
  UPLOADED
  FAILED
}

enum PerformanceTakeStatus {
  DRAFT
  SUBMITTED
}

enum PerformanceBriefAttachmentStatus {
  UPLOADING
  PARSING
  READY
  FAILED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  name                String?
  role                UserRole             @default(ACTOR)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  actorProfile        ActorProfile?
  auditLogs           AuditLog[]
  performanceProjects PerformanceProject[]

  @@index([role])
  @@index([createdAt])
}

model ActorProfile {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @db.Uuid
  slug            String             @unique
  stageName       String
  bio             String?            @db.Text
  country         String?
  city            String?
  profileImageUrl String?            @db.Text
  heroVideoUrl    String?            @db.Text
  actAiScore      Int?
  isDemo          Boolean            @default(false)
  status          ActorProfileStatus @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          ActorSkill[]
  languages       ActorLanguage[]
  accents         ActorAccent[]
  videos          ActorVideo[]
  consent         ActorConsent?
  demoProfile     DemoProfile?
  auditLogs       AuditLog[]

  @@index([slug])
  @@index([status])
  @@index([isDemo])
  @@index([createdAt])
}

model ActorSkill {
  id              String        @id @default(uuid()) @db.Uuid
  actorProfileId  String        @db.Uuid
  category        SkillCategory
  label           String?
  yearsExperience Int?
  createdAt       DateTime      @default(now())
  actorProfile    ActorProfile  @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@unique([actorProfileId, category, label])
  @@index([category])
  @@index([actorProfileId])
}

model ActorLanguage {
  id             String       @id @default(uuid()) @db.Uuid
  actorProfileId String       @db.Uuid
  language       String
  proficiency    String?
  createdAt      DateTime     @default(now())
  actorProfile   ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@unique([actorProfileId, language])
  @@index([language])
  @@index([actorProfileId])
}

model ActorAccent {
  id             String       @id @default(uuid()) @db.Uuid
  actorProfileId String       @db.Uuid
  accent         String
  createdAt      DateTime     @default(now())
  actorProfile   ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@unique([actorProfileId, accent])
  @@index([accent])
  @@index([actorProfileId])
}

model ActorVideo {
  id              String         @id @default(uuid()) @db.Uuid
  actorProfileId  String         @db.Uuid
  title           String
  description     String?        @db.Text
  videoUrl        String         @db.Text
  thumbnailUrl    String?        @db.Text
  type            VideoType
  visibility      Visibility     @default(PUBLIC)
  durationSeconds Int?
  skillCategory   SkillCategory?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  actorProfile    ActorProfile   @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([visibility])
  @@index([skillCategory])
  @@index([actorProfileId, sortOrder])
}

model ActorConsent {
  id                                     String       @id @default(uuid()) @db.Uuid
  actorProfileId                         String       @unique @db.Uuid
  publicProfileConsent                   Boolean      @default(false)
  marketingUsageConsent                  Boolean      @default(false)
  ownsUploadedContentConfirmation        Boolean      @default(false)
  futurePaidWorkRequiresSeparateApproval Boolean      @default(false)
  acceptedAt                             DateTime?
  createdAt                              DateTime     @default(now())
  updatedAt                              DateTime     @updatedAt
  actorProfile                           ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)
}

model AgencyAccessRequest {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String
  companyName           String
  role                  String?
  email                 String
  website               String?             @db.Text
  country               String?
  needs                 String              @db.Text
  expectedMonthlyVolume String?
  interestedSkills      String[]
  status                AgencyRequestStatus @default(NEW)
  message               String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

model EarlyAccessSignup {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PerformanceProject {
  id               String                    @id @default(uuid()) @db.Uuid
  ownerId          String                    @db.Uuid
  title            String
  type             String
  objective        String?                   @db.Text
  location         String?
  locationData     Json?
  targetAiTool     String?
  language         String?
  notes            String?                   @db.Text
  sourceFileName   String?
  companyName      String
  companyWebsite   String?                   @db.Text
  organizationType String?
  contactName      String?
  contactRole      String?
  performerPath    PerformancePath?
  workflowStatus   PerformanceWorkflowStatus @default(DRAFT)
  currentStep      String                    @default("company")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  owner            User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  brief            PerformanceBrief?
  briefAttachment  PerformanceBriefAttachment?
  scenes           PerformanceScene[]
  takes            PerformanceTake[]

  @@index([ownerId, updatedAt])
  @@index([workflowStatus])
}

model PerformanceBriefAttachment {
  id                 String                           @id @default(uuid()) @db.Uuid
  projectId          String                           @unique @db.Uuid
  uploadAttemptId    String                           @db.Uuid
  originalFileName   String
  contentType        String
  sizeBytes          Int
  storageBucket      String
  storagePath        String                           @db.Text
  status             PerformanceBriefAttachmentStatus @default(UPLOADING)
  extractedText      String?                          @db.Text
  extractionError    String?                          @db.Text
  uploadedAt         DateTime?
  parsedAt           DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  project            PerformanceProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PerformanceBrief {
  id                 String             @id @default(uuid()) @db.Uuid
  projectId          String             @unique @db.Uuid
  talentRequirements Json
  capturePlan        Json
  globalDirection    String             @db.Text
  qaCriteria         Json
  model              String
  openaiResponseId   String?
  generatedAt        DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  project            PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PerformanceScene {
  id                  String             @id @default(uuid()) @db.Uuid
  projectId           String             @db.Uuid
  position            Int
  title               String
  duration            String?
  referenceUrl        String?            @db.Text
  dialogue            String?            @db.Text
  direction           String?            @db.Text
  bodyPosition        String?            @db.Text
  eyeline             String?            @db.Text
  gestures            String?            @db.Text
  framing             String?            @db.Text
  captureRequirements String?            @db.Text
  uploadedFileName    String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  project             PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  take                PerformanceTake?

  @@unique([projectId, position])
  @@index([projectId])
}

model PerformanceTake {
  id               String                      @id @default(uuid()) @db.Uuid
  projectId        String                      @db.Uuid
  sceneId          String                      @unique @db.Uuid
  uploadAttemptId  String                      @db.Uuid
  originalFileName String
  contentType      String
  sizeBytes        Int
  storageBucket    String
  storagePath      String                      @db.Text
  uploadStatus     PerformanceTakeUploadStatus @default(UPLOADING)
  takeStatus       PerformanceTakeStatus       @default(DRAFT)
  uploadError      String?                     @db.Text
  uploadedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  project          PerformanceProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene            PerformanceScene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([uploadStatus])
  @@index([takeStatus])
}

model DemoProfile {
  id             String       @id @default(uuid()) @db.Uuid
  actorProfileId String       @unique @db.Uuid
  label          String       @default("Demo profile")
  description    String?      @db.Text
  source         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  actorProfile   ActorProfile @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  userId         String?       @db.Uuid
  actorProfileId String?       @db.Uuid
  createdAt      DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorProfile   ActorProfile? @relation(fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorProfileId])
  @@index([action])
  @@index([createdAt])
}
